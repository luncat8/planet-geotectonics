{
  "metadata": {
    "title": "Real Earth Tectonic and Geological Calibration Dataset",
    "count": 35,
    "description": "Ground-truth reference points across all primary tectonic regimes on Earth (cratons, collision orogens, rifts, shelves, abyssal plains, spreading ridges, deep trenches, and thick sediment basins). Used to validate K9 isostasy inversion, round-trip fidelity, and physics calibration in planet-geotectonics.",
    "sources": [
      "ETOPO 2022 Bedrock 15-arc-second / 60-arc-second Global Relief Model (NOAA NCEI)",
      "CRUST1.0 Global Crustal Model at 1x1 degree (Laske, Masters, Ma, Pasyanos 2013)",
      "GlobSed Global Sediment Thickness in the Oceans, Version 3 (Straume et al. 2019/2025)",
      "Seton et al. 2020 / EarthByte Oceanic Crustal Age Grid"
    ],
    "isostasy_model_K9": "z = -3342 + hFel/6 + (hMaf*350 + hSed*900)/3300 - thermal + zDyn, thermal = (1-ci)*350*sqrt(min(age,80)) + ci*2091"
  },
